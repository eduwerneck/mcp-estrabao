msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"

msgid "plugins.generic.estrabao.displayName"
msgstr "MCP Estrabão — triagem preliminar"

msgid "plugins.generic.estrabao.description"
msgstr "Triagem APA com bloqueio experimental da confirmação, habilitado separadamente em homologação."

msgid "plugins.generic.estrabao.apaNotAccepted"
msgstr "A submissão não foi aceita: foram identificadas incompatibilidades com APA 7. Referências em ABNT não são aceitas. Adeque o manuscrito antes de tentar novamente."

msgid "plugins.generic.estrabao.apaReviewRequired"
msgstr "A submissão não pôde ser concluída: a conformidade com APA 7 exige revisão editorial. Isso não significa que ABNT tenha sido identificada. Entre em contato com a equipe editorial."

msgid "plugins.generic.estrabao.reviewTitle"
msgstr "Revisão editorial de APA 7"

msgid "plugins.generic.estrabao.reviewScope"
msgstr "Área restrita à gerência editorial. A revisão libera apenas a conclusão da submissão; não significa aceite para publicação."

msgid "plugins.generic.estrabao.reviewSubmission"
msgstr "Número da submissão"

msgid "plugins.generic.estrabao.reviewOpen"
msgstr "Abrir revisão"

msgid "plugins.generic.estrabao.reviewSaved"
msgstr "Decisão editorial registrada."

msgid "plugins.generic.estrabao.reviewNotSaved"
msgstr "A decisão não foi registrada. Confira sua permissão, atualize a página e revise a versão atual do manuscrito."

msgid "plugins.generic.estrabao.reviewUnavailable"
msgstr "Revisão indisponível. Confira a submissão e a configuração do laboratório."

msgid "plugins.generic.estrabao.reviewReadFile"
msgstr "Antes de liberar, abra e confira o manuscrito atual no fluxo do OJS. A liberação vale apenas para a versão analisada; se o arquivo mudar, uma nova revisão será necessária."

msgid "plugins.generic.estrabao.reviewDeclaration"
msgstr "Conferi as citações e referências do manuscrito atual e confirmo sua adequação à APA 7."

msgid "plugins.generic.estrabao.reviewApprove"
msgstr "Liberar conclusão da submissão"

msgid "plugins.generic.estrabao.reviewRevoke"
msgstr "Revogar liberação"

msgid "plugins.generic.estrabao.reviewHistory"
msgstr "Histórico de decisões"

msgid "plugins.generic.estrabao.reviewEditor"
msgstr "Responsável"

msgid "plugins.generic.estrabao.reviewApproved"
msgstr "Liberação registrada para a versão revisada"

msgid "plugins.generic.estrabao.reviewRevoked"
msgstr "Liberação revogada"

msgid "plugins.generic.estrabao.reviewNoHistory"
msgstr "Nenhuma decisão registrada."

msgid "plugins.generic.estrabao.reviewActive"
msgstr "Há liberação editorial válida para esta versão do manuscrito."

msgid "plugins.generic.estrabao.reviewDownload"
msgstr "Baixar a versão atual do manuscrito para revisão"

msgid "plugins.generic.estrabao.deskTitle"
msgstr "Devolutiva para revisão"

msgid "plugins.generic.estrabao.deskType"
msgstr "Tipo editorial do manuscrito"

msgid "plugins.generic.estrabao.deskChooseType"
msgstr "Selecione para aplicar os limites corretos"

msgid "plugins.generic.estrabao.deskArticle"
msgstr "Artigo"

msgid "plugins.generic.estrabao.deskCommunication"
msgstr "Comunicação de Pesquisa"

msgid "plugins.generic.estrabao.deskGenerate"
msgstr "Gerar devolutiva"

msgid "plugins.generic.estrabao.deskGenerated"
msgstr "Devolutiva gerada. Revise antes de copiar."

msgid "plugins.generic.estrabao.deskUnavailable"
msgstr "Não foi possível gerar a devolutiva. Atualize a revisão, selecione o tipo editorial e confira as fontes disponíveis."

msgid "plugins.generic.estrabao.deskNotice"
msgstr "Revise e ajuste o texto antes de copiar. A edição fica apenas nesta página e não é salva. Se o manuscrito ou os metadados mudarem, gere uma nova devolutiva. Nada será enviado aos autores."

msgid "plugins.generic.estrabao.deskLanguage"
msgstr "O modelo aprovado gera a carta em português."

msgid "plugins.generic.estrabao.deskSubject"
msgstr "Assunto"

msgid "plugins.generic.estrabao.deskBody"
msgstr "Texto aos autores"

msgid "plugins.generic.estrabao.deskCopy"
msgstr "Copiar assunto e texto"

msgid "plugins.generic.estrabao.deskCopied"
msgstr "Assunto e texto copiados. As pendências internas não foram incluídas."

msgid "plugins.generic.estrabao.deskCopyManual"
msgstr "A cópia automática não está disponível. O texto foi selecionado: copie manualmente e confira também o assunto."

msgid "plugins.generic.estrabao.deskInternal"
msgstr "Conferência interna do editor"

msgid "plugins.generic.estrabao.deskPendingNotice"
msgstr "Itens inconclusivos para conferência; não são infrações comprovadas e esta lista não é copiada para a carta."

msgid "plugins.generic.estrabao.deskNoPending"
msgstr "Nenhuma pendência identificada pelas verificações disponíveis."

msgid "plugins.generic.estrabao.deskPendingFunding"
msgstr "Aplicabilidade do fomento"

msgid "plugins.generic.estrabao.deskPendingMetadata"
msgstr "Metadados e apresentação de títulos"

msgid "plugins.generic.estrabao.deskPendingAbstracts"
msgstr "Resumos"

msgid "plugins.generic.estrabao.deskPendingAuthors"
msgstr "Dados e identificação de autores"

msgid "plugins.generic.estrabao.deskPendingReferences"
msgstr "Referências e citações"

msgid "plugins.generic.estrabao.deskPendingManuscript"
msgstr "Estrutura, formatação e outras verificações do manuscrito"

msgid "plugins.generic.estrabao.titleGuidance"
msgstr "Evite títulos e subtítulos inteiramente em CAIXA ALTA, nos metadados e no manuscrito. Preserve siglas e nomes próprios; revise casos ambíguos. Subtítulo é opcional. Não há conversão automática do texto."

msgid "plugins.generic.estrabao.deskPendingFootnotes"
msgstr "Notas de rodapé e conferência de linhas"

msgid "plugins.generic.estrabao.footnoteReviewInstructions"
msgstr "Abra o arquivo atual em um editor, no modo de impressão, com as fontes e a configuração de página corretas. Confira no máximo duas linhas visuais por nota, somando eventuais continuações em outra página. O total deve ser conferido na página; o comprimento do texto não substitui essa conferência. Esta ficha não registra aprovação."

msgid "plugins.generic.estrabao.footnoteReviewDownload"
msgstr "Baixar o manuscrito atual para conferência"

msgid "plugins.generic.estrabao.footnoteReviewCount"
msgstr "Notas Word vinculadas confirmadas (limite: 3):"

msgid "plugins.generic.estrabao.footnoteReviewCall"
msgstr "Conferir chamada Word na posição de leitura (não é o número impresso da nota):"

msgid "plugins.generic.estrabao.footnoteReviewMore"
msgstr "Chamadas adicionais não listadas; conferir também:"

msgid "plugins.generic.estrabao.footnoteReviewUnresolved"
msgstr "O inventário está inconclusivo. Resolva os vínculos ou confira todas as notas no arquivo; não presuma zero notas."

msgid "plugins.generic.estrabao.footnoteReviewEndnotes"
msgstr "Há indicadores de notas de fim. Elas não foram contadas como rodapés nem aprovadas; confira separadamente seu tratamento editorial."

msgid "plugins.generic.estrabao.footnoteReviewManual"
msgstr "Anotações manuais, texto em imagens e a necessidade editorial das notas não são verificados por esta contagem. Uma pendência não constitui descumprimento comprovado e não entra automaticamente na carta aos autores."

msgid "plugins.generic.estrabao.submittedOn"
msgstr "Submetido em"

msgid "plugins.generic.estrabao.deskPendingCredit"
msgstr "CRediT: conferir taxonomia, atribuição a todos os autores e veracidade"
