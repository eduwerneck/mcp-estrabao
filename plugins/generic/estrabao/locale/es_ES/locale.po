msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es_ES\n"

msgid "plugins.generic.estrabao.displayName"
msgstr "MCP Estrabão — revisión preliminar"

msgid "plugins.generic.estrabao.description"
msgstr "Revisión APA con bloqueo experimental de la confirmación, habilitado por separado en pruebas."

msgid "plugins.generic.estrabao.apaNotAccepted"
msgstr "No se aceptó el envío: se identificaron incompatibilidades con APA 7. No se aceptan referencias en ABNT. Corrija el manuscrito antes de intentarlo de nuevo."

msgid "plugins.generic.estrabao.apaReviewRequired"
msgstr "No se pudo completar el envío: el cumplimiento de APA 7 requiere revisión editorial. Esto no significa que se haya identificado ABNT. Contacte con el equipo editorial."

msgid "plugins.generic.estrabao.reviewTitle"
msgstr "Revisión editorial de APA 7"

msgid "plugins.generic.estrabao.reviewScope"
msgstr "Área restringida a gestores de la revista. Esta revisión permite completar el envío; no acepta el artículo para publicación."

msgid "plugins.generic.estrabao.reviewSubmission"
msgstr "Número del envío"

msgid "plugins.generic.estrabao.reviewOpen"
msgstr "Abrir revisión"

msgid "plugins.generic.estrabao.reviewSaved"
msgstr "Decisión editorial registrada."

msgid "plugins.generic.estrabao.reviewNotSaved"
msgstr "No se registró la decisión. Compruebe sus permisos, actualice la página y revise la versión actual del manuscrito."

msgid "plugins.generic.estrabao.reviewUnavailable"
msgstr "Revisión no disponible. Compruebe el envío y la configuración de pruebas."

msgid "plugins.generic.estrabao.reviewReadFile"
msgstr "Descargue y revise el manuscrito actual antes de autorizarlo. La autorización solo es válida para la versión analizada; cambiar el archivo requiere otra revisión."

msgid "plugins.generic.estrabao.reviewDeclaration"
msgstr "Revisé las citas y referencias del manuscrito actual y confirmo su adecuación a APA 7."

msgid "plugins.generic.estrabao.reviewApprove"
msgstr "Permitir completar el envío"

msgid "plugins.generic.estrabao.reviewRevoke"
msgstr "Revocar autorización"

msgid "plugins.generic.estrabao.reviewHistory"
msgstr "Historial de decisiones"

msgid "plugins.generic.estrabao.reviewEditor"
msgstr "Responsable"

msgid "plugins.generic.estrabao.reviewApproved"
msgstr "Autorización registrada para la versión revisada"

msgid "plugins.generic.estrabao.reviewRevoked"
msgstr "Autorización revocada"

msgid "plugins.generic.estrabao.reviewNoHistory"
msgstr "No hay decisiones registradas."

msgid "plugins.generic.estrabao.reviewActive"
msgstr "Hay una autorización editorial válida para esta versión del manuscrito."

msgid "plugins.generic.estrabao.reviewDownload"
msgstr "Descargar la versión actual del manuscrito para revisión"

msgid "plugins.generic.estrabao.deskTitle"
msgstr "Devolución para revisar"

msgid "plugins.generic.estrabao.deskType"
msgstr "Tipo editorial del manuscrito"

msgid "plugins.generic.estrabao.deskChooseType"
msgstr "Seleccione para aplicar los límites correctos"

msgid "plugins.generic.estrabao.deskArticle"
msgstr "Artículo"

msgid "plugins.generic.estrabao.deskCommunication"
msgstr "Comunicación de investigación"

msgid "plugins.generic.estrabao.deskGenerate"
msgstr "Generar devolución"

msgid "plugins.generic.estrabao.deskGenerated"
msgstr "Devolución generada. Revise antes de copiar."

msgid "plugins.generic.estrabao.deskUnavailable"
msgstr "No se pudo generar la devolución. Actualice la revisión, seleccione el tipo editorial y compruebe las fuentes disponibles."

msgid "plugins.generic.estrabao.deskNotice"
msgstr "Revise y ajuste el texto antes de copiar. Los cambios solo permanecen en esta página y no se guardan. Si cambian el manuscrito o los metadatos, genere una nueva devolución. No se envía nada a los autores."

msgid "plugins.generic.estrabao.deskLanguage"
msgstr "El modelo aprobado genera la carta en portugués."

msgid "plugins.generic.estrabao.deskSubject"
msgstr "Asunto"

msgid "plugins.generic.estrabao.deskBody"
msgstr "Texto para los autores"

msgid "plugins.generic.estrabao.deskCopy"
msgstr "Copiar asunto y texto"

msgid "plugins.generic.estrabao.deskCopied"
msgstr "Asunto y texto copiados. No se incluyeron las comprobaciones internas pendientes."

msgid "plugins.generic.estrabao.deskCopyManual"
msgstr "La copia automática no está disponible. El texto está seleccionado: cópielo manualmente y compruebe también el asunto."

msgid "plugins.generic.estrabao.deskInternal"
msgstr "Comprobación interna del editor"

msgid "plugins.generic.estrabao.deskPendingNotice"
msgstr "Comprobaciones inconclusas para revisión; no son infracciones comprobadas y esta lista no se copia en la carta."

msgid "plugins.generic.estrabao.deskNoPending"
msgstr "No se identificaron comprobaciones pendientes."

msgid "plugins.generic.estrabao.deskPendingFunding"
msgstr "Aplicabilidad de la financiación"

msgid "plugins.generic.estrabao.deskPendingMetadata"
msgstr "Metadatos y presentación de títulos"

msgid "plugins.generic.estrabao.deskPendingAbstracts"
msgstr "Resúmenes"

msgid "plugins.generic.estrabao.deskPendingAuthors"
msgstr "Datos e identificación de autores"

msgid "plugins.generic.estrabao.deskPendingReferences"
msgstr "Referencias y citas"

msgid "plugins.generic.estrabao.deskPendingManuscript"
msgstr "Estructura, formato y otras comprobaciones del manuscrito"

msgid "plugins.generic.estrabao.titleGuidance"
msgstr "Evite títulos y subtítulos íntegramente en MAYÚSCULAS, en los metadatos y el manuscrito. Conserve siglas y nombres propios; revise casos ambiguos. El subtítulo es opcional. El texto no se convierte automáticamente."

msgid "plugins.generic.estrabao.deskPendingFootnotes"
msgstr "Notas al pie y revisión de líneas"

msgid "plugins.generic.estrabao.footnoteReviewInstructions"
msgstr "Abra el archivo actual en un editor en vista de impresión con las fuentes y la configuración de página correctas. Compruebe un máximo de dos líneas visuales por nota, incluidas las continuaciones en otra página. Compruebe el total en la página; la longitud del texto no sustituye esta revisión. Esta ficha no registra aprobación."

msgid "plugins.generic.estrabao.footnoteReviewDownload"
msgstr "Descargar el manuscrito actual para revisión"

msgid "plugins.generic.estrabao.footnoteReviewCount"
msgstr "Notas Word vinculadas confirmadas (límite: 3):"

msgid "plugins.generic.estrabao.footnoteReviewCall"
msgstr "Revisar llamada Word por orden de lectura (no es el número impreso de la nota):"

msgid "plugins.generic.estrabao.footnoteReviewMore"
msgstr "Llamadas adicionales no enumeradas; revisar también:"

msgid "plugins.generic.estrabao.footnoteReviewUnresolved"
msgstr "El inventario es inconcluso. Resuelva los vínculos o revise todas las notas en el archivo; no suponga cero notas."

msgid "plugins.generic.estrabao.footnoteReviewEndnotes"
msgstr "Se encontraron indicadores de notas finales. No fueron contadas como notas al pie ni aprobadas; revise su tratamiento editorial por separado."

msgid "plugins.generic.estrabao.footnoteReviewManual"
msgstr "Las anotaciones manuales, el texto en imágenes y la necesidad editorial de las notas quedan fuera de este conteo. Un elemento pendiente no es una infracción confirmada y no se incluye automáticamente en la carta a los autores."

msgid "plugins.generic.estrabao.submittedOn"
msgstr "Enviado el"

msgid "plugins.generic.estrabao.deskPendingCredit"
msgstr "CRediT: revisar taxonomía, atribución a todos los autores y veracidad"
