msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en_US\n"

msgid "plugins.generic.estrabao.displayName"
msgstr "MCP Estrabão — preliminary screening"

msgid "plugins.generic.estrabao.description"
msgstr "APA screening with an experimental confirmation gate, separately enabled in staging."

msgid "plugins.generic.estrabao.apaNotAccepted"
msgstr "The submission was not accepted: incompatibilities with APA 7 were found. ABNT references are not accepted. Correct the manuscript before trying again."

msgid "plugins.generic.estrabao.apaReviewRequired"
msgstr "The submission could not be completed: APA 7 compliance requires editorial review. This does not mean that ABNT was detected. Contact the editorial team."

msgid "plugins.generic.estrabao.reviewTitle"
msgstr "APA 7 editorial review"

msgid "plugins.generic.estrabao.reviewScope"
msgstr "Restricted to journal managers. This review releases submission completion only; it does not accept the article for publication."

msgid "plugins.generic.estrabao.reviewSubmission"
msgstr "Submission number"

msgid "plugins.generic.estrabao.reviewOpen"
msgstr "Open review"

msgid "plugins.generic.estrabao.reviewSaved"
msgstr "Editorial decision recorded."

msgid "plugins.generic.estrabao.reviewNotSaved"
msgstr "The decision was not recorded. Check your permissions, refresh this page and review the current manuscript version."

msgid "plugins.generic.estrabao.reviewUnavailable"
msgstr "Review unavailable. Check the submission and staging configuration."

msgid "plugins.generic.estrabao.reviewReadFile"
msgstr "Download and review the current manuscript before releasing it. The release is valid only for the analyzed version; changing the file requires another review."

msgid "plugins.generic.estrabao.reviewDeclaration"
msgstr "I checked the citations and references in the current manuscript and confirm compliance with APA 7."

msgid "plugins.generic.estrabao.reviewApprove"
msgstr "Release submission completion"

msgid "plugins.generic.estrabao.reviewRevoke"
msgstr "Revoke release"

msgid "plugins.generic.estrabao.reviewHistory"
msgstr "Decision history"

msgid "plugins.generic.estrabao.reviewEditor"
msgstr "Reviewer"

msgid "plugins.generic.estrabao.reviewApproved"
msgstr "Release recorded for the reviewed version"

msgid "plugins.generic.estrabao.reviewRevoked"
msgstr "Release revoked"

msgid "plugins.generic.estrabao.reviewNoHistory"
msgstr "No decisions recorded."

msgid "plugins.generic.estrabao.reviewActive"
msgstr "There is a valid editorial release for this manuscript version."

msgid "plugins.generic.estrabao.reviewDownload"
msgstr "Download the current manuscript for review"

msgid "plugins.generic.estrabao.deskTitle"
msgstr "Draft response for review"

msgid "plugins.generic.estrabao.deskType"
msgstr "Editorial manuscript type"

msgid "plugins.generic.estrabao.deskChooseType"
msgstr "Select to apply the correct limits"

msgid "plugins.generic.estrabao.deskArticle"
msgstr "Article"

msgid "plugins.generic.estrabao.deskCommunication"
msgstr "Research communication"

msgid "plugins.generic.estrabao.deskGenerate"
msgstr "Generate response"

msgid "plugins.generic.estrabao.deskGenerated"
msgstr "Response generated. Review before copying."

msgid "plugins.generic.estrabao.deskUnavailable"
msgstr "The response could not be generated. Refresh the review, select the manuscript type and check the available sources."

msgid "plugins.generic.estrabao.deskNotice"
msgstr "Review and edit before copying. Edits stay on this page and are not saved. Generate a new response if the manuscript or metadata changes. Nothing is sent to authors."

msgid "plugins.generic.estrabao.deskLanguage"
msgstr "The approved template produces the letter in Portuguese."

msgid "plugins.generic.estrabao.deskSubject"
msgstr "Subject"

msgid "plugins.generic.estrabao.deskBody"
msgstr "Message to authors"

msgid "plugins.generic.estrabao.deskCopy"
msgstr "Copy subject and message"

msgid "plugins.generic.estrabao.deskCopied"
msgstr "Subject and message copied. Internal pending checks were not included."

msgid "plugins.generic.estrabao.deskCopyManual"
msgstr "Automatic copy is unavailable. The message is selected: copy it manually and also check the subject."

msgid "plugins.generic.estrabao.deskInternal"
msgstr "Internal editorial checks"

msgid "plugins.generic.estrabao.deskPendingNotice"
msgstr "Inconclusive checks for review, not proven violations. This list is not copied into the letter."

msgid "plugins.generic.estrabao.deskNoPending"
msgstr "No pending checks identified by the available checks."

msgid "plugins.generic.estrabao.deskPendingFunding"
msgstr "Funding applicability"

msgid "plugins.generic.estrabao.deskPendingMetadata"
msgstr "Metadata and title presentation"

msgid "plugins.generic.estrabao.deskPendingAbstracts"
msgstr "Abstracts"

msgid "plugins.generic.estrabao.deskPendingAuthors"
msgstr "Author data and identification"

msgid "plugins.generic.estrabao.deskPendingReferences"
msgstr "References and citations"

msgid "plugins.generic.estrabao.deskPendingManuscript"
msgstr "Manuscript structure, formatting and other checks"

msgid "plugins.generic.estrabao.titleGuidance"
msgstr "Avoid titles and subtitles entirely in UPPERCASE, in metadata and the manuscript. Preserve acronyms and proper names; review ambiguous cases. Subtitles are optional. Text is not converted automatically."

msgid "plugins.generic.estrabao.deskPendingFootnotes"
msgstr "Footnotes and visual line review"

msgid "plugins.generic.estrabao.footnoteReviewInstructions"
msgstr "Open the current file in an editor in print layout with the correct fonts and page settings. Check at most two visual lines per note, including continuations on another page. Check the total on the page; text length does not replace this review. This checklist does not record approval."

msgid "plugins.generic.estrabao.footnoteReviewDownload"
msgstr "Download the current manuscript for review"

msgid "plugins.generic.estrabao.footnoteReviewCount"
msgstr "Confirmed linked Word footnotes (limit: 3):"

msgid "plugins.generic.estrabao.footnoteReviewCall"
msgstr "Review Word call in reading order (not the printed note number):"

msgid "plugins.generic.estrabao.footnoteReviewMore"
msgstr "Additional calls not listed; review these too:"

msgid "plugins.generic.estrabao.footnoteReviewUnresolved"
msgstr "The inventory is inconclusive. Resolve the links or review all notes in the file; do not assume zero notes."

msgid "plugins.generic.estrabao.footnoteReviewEndnotes"
msgstr "Endnote indicators were found. They were not counted as footnotes or approved; review their editorial treatment separately."

msgid "plugins.generic.estrabao.footnoteReviewManual"
msgstr "Manual annotations, text in images and the editorial need for notes are outside this count. An unresolved item is not a confirmed violation and is not automatically included in the author letter."

msgid "plugins.generic.estrabao.submittedOn"
msgstr "Submitted on"

msgid "plugins.generic.estrabao.deskPendingCredit"
msgstr "CRediT: review taxonomy, attribution to all authors and veracity"
