msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en_US\n"

msgid "plugins.generic.estrabao.displayName"
msgstr "MCP Estrabão — preliminary screening"

msgid "plugins.generic.estrabao.description"
msgstr "APA screening with an experimental confirmation gate, separately enabled in staging."

msgid "plugins.generic.estrabao.apaNotAccepted"
msgstr "The submission was not accepted: incompatibilities with APA 7 or the journal’s citation guidelines were found. ABNT references are not accepted. Correct the manuscript before trying again."

msgid "plugins.generic.estrabao.apaReviewRequired"
msgstr "The submission could not be completed: APA 7 compliance requires editorial review. This does not mean that ABNT was detected. Contact the editorial team."

msgid "plugins.generic.estrabao.reviewTitle"
msgstr "APA 7 editorial review"

msgid "plugins.generic.estrabao.reviewScope"
msgstr "Restricted to journal managers. This review releases submission completion only; it does not accept the article for publication."

msgid "plugins.generic.estrabao.reviewSubmission"
msgstr "Submission number"

msgid "plugins.generic.estrabao.reviewOpen"
msgstr "Open review"

msgid "plugins.generic.estrabao.reviewSaved"
msgstr "Editorial decision recorded."

msgid "plugins.generic.estrabao.reviewNotSaved"
msgstr "The decision was not recorded. Check your permissions, refresh this page and review the current manuscript version."

msgid "plugins.generic.estrabao.reviewUnavailable"
msgstr "Review unavailable. Check the submission and staging configuration."

msgid "plugins.generic.estrabao.reviewReadFile"
msgstr "Download and review the current manuscript before releasing it. The release is valid only for the analyzed version; changing the file requires another review."

msgid "plugins.generic.estrabao.reviewDeclaration"
msgstr "I checked the citations and references in the current manuscript and confirm compliance with APA 7."

msgid "plugins.generic.estrabao.reviewApprove"
msgstr "Release submission completion"

msgid "plugins.generic.estrabao.reviewRevoke"
msgstr "Revoke release"

msgid "plugins.generic.estrabao.reviewHistory"
msgstr "Decision history"

msgid "plugins.generic.estrabao.reviewEditor"
msgstr "Reviewer"

msgid "plugins.generic.estrabao.reviewApproved"
msgstr "Release recorded for the reviewed version"

msgid "plugins.generic.estrabao.reviewRevoked"
msgstr "Release revoked"

msgid "plugins.generic.estrabao.reviewNoHistory"
msgstr "No decisions recorded."

msgid "plugins.generic.estrabao.reviewActive"
msgstr "There is a valid editorial release for this manuscript version."

msgid "plugins.generic.estrabao.reviewDownload"
msgstr "Download the current manuscript for review"

msgid "plugins.generic.estrabao.deskTitle"
msgstr "Draft response for review"

msgid "plugins.generic.estrabao.deskType"
msgstr "Editorial manuscript type"

msgid "plugins.generic.estrabao.deskChooseType"
msgstr "Select to apply the correct limits"

msgid "plugins.generic.estrabao.deskArticle"
msgstr "Article"

msgid "plugins.generic.estrabao.deskCommunication"
msgstr "Research communication"

msgid "plugins.generic.estrabao.deskGenerate"
msgstr "Generate response"

msgid "plugins.generic.estrabao.deskGenerated"
msgstr "Response generated. Review before copying."

msgid "plugins.generic.estrabao.deskUnavailable"
msgstr "The response could not be generated. Refresh the review, select the manuscript type and check the available sources."

msgid "plugins.generic.estrabao.deskNotice"
msgstr "Review and edit before copying. Edits stay on this page and are not saved. Generate a new response if the manuscript or metadata changes. Nothing is sent to authors."

msgid "plugins.generic.estrabao.deskLanguage"
msgstr "The approved template produces the letter in Portuguese."

msgid "plugins.generic.estrabao.deskSubject"
msgstr "Subject"

msgid "plugins.generic.estrabao.deskBody"
msgstr "Message to authors"

msgid "plugins.generic.estrabao.deskCopy"
msgstr "Copy subject and message"

msgid "plugins.generic.estrabao.deskCopied"
msgstr "Subject and message copied. Internal pending checks were not included."

msgid "plugins.generic.estrabao.deskCopyManual"
msgstr "Automatic copy is unavailable. The message is selected: copy it manually and also check the subject."

msgid "plugins.generic.estrabao.deskInternal"
msgstr "Internal editorial checks"

msgid "plugins.generic.estrabao.deskPendingNotice"
msgstr "Inconclusive checks for review, not proven violations. This list is not copied into the letter."

msgid "plugins.generic.estrabao.deskNoPending"
msgstr "No pending checks identified by the available checks."

msgid "plugins.generic.estrabao.deskPendingFunding"
msgstr "Funding applicability"

msgid "plugins.generic.estrabao.deskPendingMetadata"
msgstr "Metadata and title presentation"

msgid "plugins.generic.estrabao.deskPendingAbstracts"
msgstr "Abstracts"

msgid "plugins.generic.estrabao.deskPendingAuthors"
msgstr "Author data and identification"

msgid "plugins.generic.estrabao.deskPendingReferences"
msgstr "References and citations"

msgid "plugins.generic.estrabao.deskPendingManuscript"
msgstr "Manuscript structure, formatting and other checks"

msgid "plugins.generic.estrabao.titleGuidance"
msgstr "Avoid titles and subtitles entirely in UPPERCASE, in metadata and the manuscript. Preserve acronyms and proper names; review ambiguous cases. Subtitles are optional. Text is not converted automatically."

msgid "plugins.generic.estrabao.deskPendingFootnotes"
msgstr "Footnotes and visual line review"

msgid "plugins.generic.estrabao.footnoteReviewInstructions"
msgstr "Open the current file in an editor in print layout with the correct fonts and page settings. Check at most two visual lines per note, including continuations on another page. Check the total on the page; text length does not replace this review. This checklist does not record approval."

msgid "plugins.generic.estrabao.footnoteReviewDownload"
msgstr "Download the current manuscript for review"

msgid "plugins.generic.estrabao.footnoteReviewCount"
msgstr "Confirmed linked Word footnotes (limit: 3):"

msgid "plugins.generic.estrabao.footnoteReviewCall"
msgstr "Review Word call in reading order (not the printed note number):"

msgid "plugins.generic.estrabao.footnoteReviewMore"
msgstr "Additional calls not listed; review these too:"

msgid "plugins.generic.estrabao.footnoteReviewUnresolved"
msgstr "The inventory is inconclusive. Resolve the links or review all notes in the file; do not assume zero notes."

msgid "plugins.generic.estrabao.footnoteReviewEndnotes"
msgstr "Endnote indicators were found. They were not counted as footnotes or approved; review their editorial treatment separately."

msgid "plugins.generic.estrabao.footnoteReviewManual"
msgstr "Manual annotations, text in images and the editorial need for notes are outside this count. An unresolved item is not a confirmed violation and is not automatically included in the author letter."

msgid "plugins.generic.estrabao.submittedOn"
msgstr "Submitted on"

msgid "plugins.generic.estrabao.deskPendingCredit"
msgstr "CRediT: review taxonomy, attribution to all authors and veracity"

msgid "plugins.generic.estrabao.fundingReviewBoth"
msgstr "Both sources declare support/funding. Compare agencies, projects and award numbers when provided. Acronyms and full names may identify the same institution; equivalence was not verified automatically."

msgid "plugins.generic.estrabao.fundingReviewOjsOnly"
msgstr "OJS records support, but no corresponding funding declaration was recognized in Word. Confirm whether the support is financial; if so, complete the manuscript declaration. Nonfinancial institutional support does not prove omitted funding."

msgid "plugins.generic.estrabao.fundingReviewUnavailable"
msgstr "The funding comparison is inconclusive. Review Word and the availability of the supporting agencies field during submission. A disabled or editorial-only field, or incomplete reading, does not prove omission."

msgid "plugins.generic.estrabao.deskPendingEthics"
msgstr "Ethics: applicability and declaration"

msgid "plugins.generic.estrabao.ethicsReviewCandidates"
msgstr "Possible ethics mentions were found in the listed paragraphs. They may be discussion, quotation or negation; they do not prove approval or an adequate declaration."

msgid "plugins.generic.estrabao.ethicsReviewNoMarkers"
msgstr "No mentions were found in the scanned text. This does not prove a missing declaration or exemption: review the materials provided in the editorial workflow."

msgid "plugins.generic.estrabao.ethicsReviewUnavailable"
msgstr "The reading does not establish ethics declarations. Review the materials provided in the editorial workflow; no omission or violation was proved automatically."

msgid "plugins.generic.estrabao.ethicsReviewInstructions"
msgstr "Confirm applicability to the study. Where applicable, review committee approval and the opinion number; where not applicable, review the formal declaration. Authenticity and adequacy were not validated. This checklist neither records approval nor sends requirements to authors."

msgid "plugins.generic.estrabao.ethicsReviewPosition"
msgstr "Extracted Word paragraph position (not a page number):"

msgid "plugins.generic.estrabao.ethicsReviewMore"
msgstr "Additional mentions not listed; review these too:"

msgid "plugins.generic.estrabao.deskPendingAi"
msgstr "Declaration of AI use or non-use"

msgid "plugins.generic.estrabao.aiReviewNonUse"
msgstr "An explicit textual non-use statement was observed. This records what the authors declared; it does not verify actual tool use."

msgid "plugins.generic.estrabao.aiReviewTextPresent"
msgstr "Text was found under the declaration heading. Text presence does not prove that all required details were supplied or that the purpose is permitted."

msgid "plugins.generic.estrabao.aiReviewEmpty"
msgstr "The declaration heading was found without text. Check whether the declaration appears elsewhere in the manuscript; no specific heading is required. If review confirms it is missing, request a use or non-use declaration."

msgid "plugins.generic.estrabao.aiReviewUnresolved"
msgstr "The reading does not establish the declaration. Review the manuscript, including material outside automatic reading; missing markers do not prove a missing declaration."

msgid "plugins.generic.estrabao.aiReviewInstructions"
msgstr "Authors must declare AI use or non-use in the manuscript. For declared use, review the tool, purpose and interaction level; only technical support for language revision, translation, formatting and illustrative figures is permitted. For declared non-use, do not require tool details. Duplication in Comments for the Editor is not required. This checklist does not detect actual use, record approval or enter the author letter."

msgid "plugins.generic.estrabao.referenceHelp"
msgstr "Enter each complete reference on its own line, using Enter between references. Automatic wrapping on screen does not separate entries; do not use Enter inside one reference. Extra blank lines are not required."

msgid "plugins.generic.estrabao.referenceJoinedWarning"
msgstr "There are signs of more than one reference on the same line. Check the text and use Enter between complete references. This notice does not confirm work identity or Crossref matching."

msgid "plugins.generic.estrabao.referenceSeparationReview"
msgstr "The automatic check could not establish the reference boundaries. Check the separation manually."

msgid "plugins.generic.estrabao.directQuoteReviewTitle"
msgstr "Direct quotation review"

msgid "plugins.generic.estrabao.fullDateReviewTitle"
msgstr "Bibliographic date review"

msgid "plugins.generic.estrabao.editorialTitle"
msgstr "Editorial review record"

msgid "plugins.generic.estrabao.editorialScope"
msgstr "Record what was reviewed in this analysis. The engine does not prefill these states. This record does not release submission, change triage findings or replace APA review."

msgid "plugins.generic.estrabao.editorialCurrent"
msgstr "A record matches this analysis."

msgid "plugins.generic.estrabao.editorialStale"
msgstr "The latest record belongs to another analysis. Review the items again before recording."

msgid "plugins.generic.estrabao.editorialEmpty"
msgstr "No review recorded for this analysis."

msgid "plugins.generic.estrabao.editorialDeclaration"
msgstr "I confirm the selected states for the file and data in this analysis. This record is not editorial acceptance."

msgid "plugins.generic.estrabao.editorialSave"
msgstr "Save review record"

msgid "plugins.generic.estrabao.editorialSaved"
msgstr "Editorial review recorded. APA release remains independent."

msgid "plugins.generic.estrabao.editorialNotSaved"
msgstr "Review not saved. Generate the analysis again and check the selected states."

msgid "plugins.generic.estrabao.editorialUnavailable"
msgstr "Review records are unavailable. The draft and APA review remain independent."

msgid "plugins.generic.estrabao.editorialLimit"
msgstr "The record limit has been reached. The draft and APA review remain available."

msgid "plugins.generic.estrabao.editorialHistory"
msgstr "Editorial review history"

msgid "plugins.generic.estrabao.editorialMatches"
msgstr "Record for this analysis."

msgid "plugins.generic.estrabao.editorialOther"
msgstr "Record for another analysis."

msgid "plugins.generic.estrabao.editorialState_pending"
msgstr "Pending"

msgid "plugins.generic.estrabao.editorialState_reviewed"
msgstr "Reviewed by editor"

msgid "plugins.generic.estrabao.editorialState_adjustments"
msgstr "Needs adjustments"

msgid "plugins.generic.estrabao.editorialState_not_applicable"
msgstr "Not applicable (reviewed by editor)"

msgid "plugins.generic.estrabao.editorialItem_metadata"
msgstr "Metadata in all three languages"

msgid "plugins.generic.estrabao.editorialItem_abstracts"
msgstr "Abstracts and keywords"

msgid "plugins.generic.estrabao.editorialItem_authors"
msgstr "Authorship and ORCID"

msgid "plugins.generic.estrabao.editorialItem_structure"
msgstr "Structure and sections"

msgid "plugins.generic.estrabao.editorialItem_length"
msgstr "Manuscript length"

msgid "plugins.generic.estrabao.editorialItem_presentation"
msgstr "Presentation and headings"

msgid "plugins.generic.estrabao.editorialItem_visuals"
msgstr "Figures, tables and charts"

msgid "plugins.generic.estrabao.editorialItem_footnotes"
msgstr "Notes"

msgid "plugins.generic.estrabao.editorialItem_credit"
msgstr "CRediT contributions"

msgid "plugins.generic.estrabao.editorialItem_funding"
msgstr "Funding and Word/OJS consistency"

msgid "plugins.generic.estrabao.editorialItem_ethics"
msgstr "Ethics and applicable statement"

msgid "plugins.generic.estrabao.editorialItem_ai"
msgstr "AI declaration and purpose"

msgid "plugins.generic.estrabao.docReviewTitle"
msgstr "Human review of Word .doc file"

msgid "plugins.generic.estrabao.docReviewScope"
msgstr "The journal accepts .doc. Text extraction and automated APA checks were not performed. Download the bound version, open it with macros disabled and review references and citations. Do not release if you cannot read them in full or find ABNT, apud or another APA incompatibility. Conversion to .docx is not required."

msgid "plugins.generic.estrabao.docReviewUnavailable"
msgstr "This file could not be identified within the supported binary Word subset. It remains pending editorial handling, without rejection by format or release through this screen."

msgid "plugins.generic.estrabao.docOpenedDeclaration"
msgstr "I opened this version of the .doc file and confirmed that I could read all references and citations."

msgid "plugins.generic.estrabao.docApaDeclaration"
msgstr "I personally checked APA and the citation guidelines, including the absence of ABNT and apud. I request APA release for this version; this is not editorial acceptance."

msgid "plugins.generic.estrabao.docReviewEvent"
msgstr "Human .doc review"

msgid "plugins.generic.estrabao.docAuthorPending"
msgstr "The journal accepts .doc files. This version requires human APA review by an editor before completion. It was not rejected for being .doc and automatic conversion is not required."

msgid "plugins.generic.estrabao.specialDateReviewTitle"
msgstr "Special date review"

msgid "plugins.generic.estrabao.specialDateReviewInstructions"
msgstr "Check the source for the absence of a date or in-press status and the consulted edition. s.f. and en prensa are declared markers: they do not prove publication, generate a year or get replaced automatically. Preserve declared suffixes and review ambiguities."

msgid "plugins.generic.estrabao.viewTriage"
msgstr "View triage"

msgid "plugins.generic.estrabao.reviewNotPending"
msgstr "Admission triage is available only for drafts at step 4 (Confirmation). This submission is not at that step. No decision has been changed."

msgid "plugins.generic.estrabao.reviewAnother"
msgstr "Open another submission"

msgid "plugins.generic.estrabao.reviewManuscript"
msgstr "Manuscript under review"

msgid "plugins.generic.estrabao.reviewFileUnidentified"
msgstr "A unique file could not be identified for this analysis."
